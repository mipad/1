#version 450
layout(local_size_x = 28, local_size_y = 28, local_size_z = 1) in;

// 保留声明但不使用（避免编译错误）
layout(set = 0, binding = 0, std140) uniform support_buffer
{
    uint _m0;
} support_buffer_1;

layout(set = 0, binding = 1, std140) uniform cp_c0
{
    vec4 _m0[4096];
} cp_c0_1;

layout(set = 1, binding = 0, std430) buffer cp_s0 { uint _m0[]; } cp_s0_1;
layout(set = 1, binding = 1, std430) buffer cp_s1 { uint _m0[]; } cp_s1_1;
layout(set = 1, binding = 2, std430) buffer cp_s2 { uint _m0[]; } cp_s2_1;
layout(set = 1, binding = 3, std430) buffer cp_s3 { uint _m0[]; } cp_s3_1;

// 无共享内存
// shared uint _35[64];

// 移除所有自定义函数，因为不会调用它们

void main()
{
    // 只读取工作组 ID 和局部 ID，不做任何其他操作
    uint gx = gl_WorkGroupID.x;
    uint gy = gl_WorkGroupID.y;
    uint lx = gl_LocalInvocationID.x;
    uint ly = gl_LocalInvocationID.y;

    // 简单的算术操作，避免被优化掉
    uint sum = gx + gy + lx + ly;
    sum = sum * 0x9e3779b9u;
    sum = sum ^ (sum >> 16);

    // 不写入任何 SSBO，不访问共享内存，不执行 barrier
    // 不调用任何自定义函数

    // 可选的：仅保留一个空的输出（防止被完全优化掉）
    // 但由于没有输出，驱动可能完全丢弃计算，不影响测试
}