#version 450
layout(local_size_x = 32, local_size_y = 32, local_size_z = 1) in;

layout(set = 0, binding = 0, std140) uniform support_buffer
{
    uint _m0;
    uint _m1[8];
    vec4 _m2;
    vec4 _m3;
    int _m4;
    float _m5[73];
    ivec4 _m6;
    int _m7;
} support_buffer_1;

layout(set = 0, binding = 1, std140) uniform vb_info
{
    uvec4 _m0;            // x: vertCountX, y: vertCountY, z: vertexBase, w: instanceBase
    uvec4 _m1;            // w: indexBufferOffset (signed, stored as bit-pattern)
    uvec4 _m2[32];        // [3].x: vertexStride
    uvec4 _m3[32];        // [3].x: propOffset, [3].y: useInstance
} vb_info_1;

layout(set = 0, binding = 2, std140) uniform vp_c0
{
    vec4 _m0[4096];
} vp_c0_1;

layout(set = 1, binding = 0, std430) buffer vertex_output
{
    float _m0[];
} vertex_output_1;

layout(set = 1, binding = 3, std430) buffer vp_s0
{
    uint _m0[];
} vp_s0_1;

layout(set = 2, binding = 0) uniform samplerBuffer ib_data;
layout(set = 2, binding = 5) uniform samplerBuffer vb_data3;

float _41[5];

void main()
{
    _41[4] = 1.0;

    // ---- 边界检查（直接使用无符号整数） ----
    if (gl_GlobalInvocationID.x >= vb_info_1._m0.x) return;
    if (gl_GlobalInvocationID.y >= vb_info_1._m0.y) return;

    uint gid_x = gl_GlobalInvocationID.x;
    uint gid_y = gl_GlobalInvocationID.y;

    // 索引缓冲区偏移（唯一需要按位解释为 int 的字段，因为可能是负值）
    int ib_offset = floatBitsToInt(uintBitsToFloat(vb_info_1._m1.w));
    int ib_index  = ib_offset + int(gid_x);   // gid_x 非负，安全
    uint ib_val   = floatBitsToUint(texelFetch(ib_data, ib_index).x);

    // 顶点基址和实例基址 —— 直接作为无符号整数使用
    uint vertex_base   = vb_info_1._m0.z;
    uint instance_base = vb_info_1._m0.w;

    uint vertex_id   = vertex_base + ib_val;
    uint instance_id = instance_base + gid_y;

    _41[0] = 0.0;
    _41[1] = 0.0;
    _41[2] = 0.0;
    _41[3] = 1.0;

    // 顶点属性信息 —— 全部为无符号整数
    uint prop_x  = vb_info_1._m3[3].x;
    uint prop_y  = vb_info_1._m3[3].y;
    uint stride  = vb_info_1._m2[3].x;

    uint index_sel = (prop_y != 0u) ? instance_id : vertex_id;
    uint vb_offset = index_sel * stride;
    uint vb_addr   = prop_x + vb_offset;

    // 读取顶点属性值（vb_addr 较大时转为 int 可能回绕，但合理设计的缓冲区不会超过 2GB）
    float vb_val = texelFetch(vb_data3, int(vb_addr)).x;

    // 无效顶点剔除（高位为 1 表示无效）
    if (floatBitsToInt(vb_val) < 0)
    {
        uint vert_count = vb_info_1._m0.x;
        uint out_base   = gid_y * vert_count + gid_x;
        uint out_idx    = out_base * 5u;

        vertex_output_1._m0[out_idx]     = _41[0];
        vertex_output_1._m0[out_idx + 1] = _41[1];
        vertex_output_1._m0[out_idx + 2] = _41[2];
        vertex_output_1._m0[out_idx + 3] = _41[3];
        vertex_output_1._m0[out_idx + 4] = _41[4];
        return;
    }

    // 有效顶点：执行清零和输出
    int val_int   = floatBitsToInt(vb_val);   // val_int >= 0 成立
    int base_off  = val_int * 48;             // 非负
    int vp_addr   = floatBitsToInt(vp_c0_1._m0[30].x);
    int base_addr = base_off + vp_addr;
    int aligned   = vp_addr & (~63);          // 64 字节对齐基址

    // vp_s0 清零（索引始终非负，因为 base_addr >= aligned）
    int off;
    off = base_addr - aligned;   vp_s0_1._m0[off >> 2] = 0u;
    off = (base_addr + 4) - aligned;   vp_s0_1._m0[off >> 2] = 0u;
    off = (base_addr + 8) - aligned;   vp_s0_1._m0[off >> 2] = 0u;
    off = (base_addr + 12) - aligned;  vp_s0_1._m0[off >> 2] = 0u;

    int base_addr2 = base_off + 16 + vp_addr;
    off = base_addr2 - aligned;   vp_s0_1._m0[off >> 2] = 0u;
    off = (base_addr2 + 4) - aligned;   vp_s0_1._m0[off >> 2] = 0u;
    off = (base_addr2 + 8) - aligned;   vp_s0_1._m0[off >> 2] = 0u;
    off = (base_addr2 + 12) - aligned;  vp_s0_1._m0[off >> 2] = 0u;

    int base_addr3 = base_off + 32 + vp_addr;
    off = base_addr3 - aligned;   vp_s0_1._m0[off >> 2] = 0u;
    off = (base_addr3 + 4) - aligned;   vp_s0_1._m0[off >> 2] = 0u;
    off = (base_addr3 + 8) - aligned;   vp_s0_1._m0[off >> 2] = 0u;
    off = (base_addr3 + 12) - aligned;  vp_s0_1._m0[off >> 2] = 0u;

    // 输出顶点数据
    uint vert_count = vb_info_1._m0.x;
    uint out_base   = gid_y * vert_count + gid_x;
    uint out_idx    = out_base * 5u;

    vertex_output_1._m0[out_idx]     = _41[0];
    vertex_output_1._m0[out_idx + 1] = _41[1];
    vertex_output_1._m0[out_idx + 2] = _41[2];
    vertex_output_1._m0[out_idx + 3] = _41[3];
    vertex_output_1._m0[out_idx + 4] = _41[4];
}